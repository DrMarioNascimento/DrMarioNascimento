});
function solta(e){
  if (!ptrs.has(e.pointerId)) return; ptrs.delete(e.pointerId);
  if (ptrs.size === 0) canvas.classList.remove('arrastando');
  if (down && down.id === e.pointerId && e.type === 'pointerup' && !arrastou && performance.now() - down.t < 450 && Math.hypot(e.clientX - down.x, e.clientY - down.y) < 7) clique(e.clientX, e.clientY);
  if (ptrs.size === 1){ const [p] = [...ptrs.values()]; down = null; inercia.dx = inercia.dy = 0; }
  if (ptrs.size === 0) down = null;
}
canvas.addEventListener('pointerup', solta); canvas.addEventListener('pointercancel', solta);
canvas.addEventListener('wheel', e => { e.preventDefault(); zoom(Math.exp(THREE.MathUtils.clamp(e.deltaY, -120, 120) * .0016)); }, { passive:false });
canvas.addEventListener('pointerleave', () => { if (!TOQUE) atualizaHover(-1, -1); });
$('#zoomMais').addEventListener('click', () => zoom(.78));
$('#zoomMenos').addEventListener('click', () => zoom(1.28));
$('#recentrar').addEventListener('click', recentra);
addEventListener('keydown', e => { if (e.key === 'Escape') desfoca(); if (e.key === '+' || e.key === '=') zoom(.8); if (e.key === '-') zoom(1.25); });

/* ---------- escolha em tela (hover / clique) ---------- */
let hover = null; const dica = $('#dica');
function sob(x, y){
  let melhor = null;
  const testa = (p, raio, extra) => { if (!p.vis) return; const d = Math.hypot(p.sx - x, p.sy - y); if (d <= Math.max(p.sr, raio) && (!melhor || p.depth < melhor.p.depth)) melhor = { p, ...extra }; };
  itens.forEach(o => testa(o, o.lua ? 12 : TOQUE ? 16 : 10, { tipo:'item' }));
  nos.forEach(n => testa(n, 12, { tipo:'no' }));
  return melhor;
}
function atualizaHover(x, y){
  const h = x < 0 ? null : sob(x, y);
  if (hover && hover.p !== h?.p){ if (hover.tipo === 'item' && !hover.p.lua){ itH[hover.p.i] = 0; itG.attributes.aH.needsUpdate = true; } if (hover.tipo === 'no') hover.p.rot.el.classList.remove('hover'); if (hover.tipo === 'item' && hover.p.lua) hover.p.rot.el.classList.remove('hover'); }
  hover = h; canvas.classList.toggle('alvo', !!h);
  if (h && h.tipo === 'item'){
    if (!h.p.lua){ itH[h.p.i] = 1; itG.attributes.aH.needsUpdate = true; } else h.p.rot.el.classList.add('hover');
    const r = h.p.n.r; dica.style.setProperty('--c', r.cor);
    dica.innerHTML = `<small>${esc(U.tipos[h.p.it[4]][0])} · ${esc(h.p.it[2])}</small><b>${esc(h.p.it[1])}</b>`;
    dica.style.transform = ''; dica.style.left = Math.min(x, W - 290) + 'px'; dica.style.top = Math.min(y, H - 90) + 'px'; dica.classList.add('on');
  } else dica.classList.remove('on');
  if (h && h.tipo === 'no') h.p.rot.el.classList.add('hover');
}
function clique(x, y){
  const h = sob(x, y);
  if (!h){ if (foco) desfoca(); return; }
  if (h.tipo === 'item') abre(h.p.it[3]); else focaNo(h.p);
}
function abre(url){ window.open(url, '_blank', 'noopener'); }

/* ---------- foco: sistema / planeta ---------- */
const painel = $('#painel'), corpoP = $('#painelCorpo');
$('#fechaPainel').addEventListener('click', desfoca);
function focaSistema(g){
  const S = sistemas[g]; foco = { tipo:'sis', g }; interagiu();
  distAlvo = Math.max(S.R * 2.75, 10);
  const mundos = nos.filter(n => n.g === g || (n.eita && n.r.grupos.includes(g)));
  mostraPainel(S.corHex, `<span class="mono">Sistema · ${mundos.length} mundos</span><h3>${esc(U.grupos[g].pt)}</h3><p class="lema">${esc(U.grupos[g].sub.pt)}</p>
    <ul class="lst">${mundos.map(n => `<li><button type="button" data-k="${n.k}" style="--pc:${n.r.cor}"><span class="nome"><i></i>${esc(n.r.nome)}<em>${n.r.total}</em></span><small>${esc(n.central ? 'estrela' : n.eita ? 'aliança' : 'planeta')} ↗</small></button></li>`).join('')}</ul>`);
  corpoP.querySelectorAll('button[data-k]').forEach(b => b.addEventListener('click', () => focaNo(nos[+b.dataset.k])));
}
function focaNo(n){
  foco = { tipo:'no', n }; interagiu();
  distAlvo = Math.max(n.raio * 6.5, 5);
  const r = n.r, sis = r.grupos ? r.grupos.map(g => U.grupos[g].pt).join(' + ') : U.grupos[r.grupo].pt;
  mostraPainel(r.cor, `<span class="mono">${esc(sis)} · ${esc(linha2(r))}</span><h3>${esc(r.nome)}</h3><p class="lema">${esc(r.lema.pt)}</p><p>${esc(r.desc.pt)}</p>
    <ul class="lst">${n.itens.map(o => `<li><a href="${o.it[3]}" target="_blank" rel="noopener"><span class="nome">${esc(o.it[1])}</span><small>${esc(o.it[2])} ↗</small></a></li>`).join('')}</ul>
    <div class="bts"><a class="btn cheio" href="${r.online}" target="_blank" rel="noopener">Abrir site ↗</a><a class="btn" href="${r.github}" target="_blank" rel="noopener">GitHub</a></div>`);
}
function mostraPainel(cor, html){ painel.style.setProperty('--c', cor); corpoP.innerHTML = html; painel.classList.add('aberto'); painel.setAttribute('aria-hidden', 'false'); painel.scrollTop = 0; }
function desfoca(){ if (!foco) return; foco = null; painel.classList.remove('aberto'); painel.setAttribute('aria-hidden', 'true'); distAlvo = distFit; }
function recentra(){ desfoca(); distAlvo = distFit; recentrando = true; inercia.dx = inercia.dy = 0; ocioso = 0; }

/* ---------- laço ---------- */
const relogio = new THREE.Timer(); let t = 0, pausado = false;
document.addEventListener('visibilitychange', () => { pausado = document.hidden; if (!pausado){ relogio.reset(); requestAnimationFrame(quadro); } });
const projeta = (local, alvo) => { tmp.copy(local).applyMatrix4(plano.matrixWorld); const dc = tmp.distanceTo(camera.position); tmp.project(camera);
  alvo.sx = (tmp.x * .5 + .5) * W; alvo.sy = (-tmp.y * .5 + .5) * H; alvo.depth = tmp.z; alvo.vis = tmp.z < 1 && alvo.sx > -80 && alvo.sx < W + 80 && alvo.sy > -80 && alvo.sy < H + 80; return dc; };
const fatorTela = () => (H / 2) / Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2);
let primeiro = true; const pb = {};
function quadro(){
  if (pausado) return;
  requestAnimationFrame(quadro);
  relogio.update(); const dt = Math.min(relogio.getDelta(), .05); t += dt; ocioso += dt;
  // órbitas
  nos.forEach(n => { if (n.orb){ const a = n.orb.fase + t * n.orb.vel; n.pos.set(SIS[n.g].c.x + Math.cos(a) * n.orb.R, 0, SIS[n.g].c.z + Math.sin(a) * n.orb.R); } n.mesh.position.copy(n.pos); n.mesh.material.uniforms.uT.value = t; n.mesh.rotation.y = t * .05; });
  itens.forEach((o, i) => { const a = o.fase + t * o.vel; const x = Math.cos(a) * o.R, s = Math.sin(a) * o.R;
    o.pos.set(o.n.pos.x + x, s * Math.sin(o.incl), o.n.pos.z + s * Math.cos(o.incl));
    if (o.mesh){ o.mesh.position.copy(o.pos); o.mesh.material.uniforms.uT.value = t; o.mesh.rotation.y = t * .3; } else itPos.set([o.pos.x, o.pos.y, o.pos.z], i * 3); });
  itG.attributes.position.needsUpdate = true;
  // pulsos
  for (let p = 0; p < NP; p++){ const [a, b] = ligLab[p % 2]; const f = ((t * .14 + p * .37) % 1); tmp2.lerpVectors(a, b, f); pulsoPos.set([tmp2.x, tmp2.y, tmp2.z], p * 3); pulsoA[p] = Math.sin(f * Math.PI); }
  pulsoG.attributes.position.needsUpdate = true; pulsoG.attributes.aA.needsUpdate = true;
  nebula.material.uniforms.uT.value = t; itPontos.material.uniforms.uT.value = t;
  scene.traverse(o => { if (o.isPoints && o.material.uniforms?.uT && o !== itPontos) o.material.uniforms.uT.value = t; });
  // rotação: inércia e giro ocioso
  if (ptrs.size === 0 && !REDUZ){
    if (Math.hypot(inercia.dx, inercia.dy) > .05){ gira(inercia.dx, inercia.dy); inercia.dx *= .94; inercia.dy *= .94; }
    else if (ocioso > 3 && !foco && !recentrando){ qTmp.setFromAxisAngle(V3(0, 1, 0), dt * .045); mundo.quaternion.multiply(qTmp); }
  }
  if (recentrando){ mundo.quaternion.slerp(qInicial, 1 - Math.exp(-dt * 4)); if (mundo.quaternion.angleTo(qInicial) < .002){ mundo.quaternion.copy(qInicial); recentrando = false; } }
  mundo.updateMatrixWorld(true);
  // câmera
  if (foco?.tipo === 'no') alvoDesejado.copy(foco.n.pos).applyMatrix4(plano.matrixWorld);
  else if (foco?.tipo === 'sis') alvoDesejado.copy(sistemas[foco.g].c).applyMatrix4(plano.matrixWorld);
  else alvoDesejado.set(0, 0, 0);
  if (foco && !MOBILE){ // desloca o alvo para a esquerda do painel
    const larguraVista = 2 * distAlvo * Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) * camera.aspect;
    alvoDesejado.x += larguraVista * ((W - painel.getBoundingClientRect().left) / W) / 2; }
  const k = 1 - Math.exp(-dt * 3.2);
  cam.alvo.lerp(alvoDesejado, k); cam.dist += (distAlvo - cam.dist) * k;
  camera.position.copy(cam.alvo); camera.position.z += cam.dist; camera.lookAt(cam.alvo); camera.updateMatrixWorld();
  // projeções: nós, itens, sistemas
  const ft = fatorTela();
  nos.forEach(n => { const dc = projeta(n.pos, n); n.sr = n.raio / dc * ft; const L = n.rot; L.vis = n.vis && n.sr > 1.5; L.x = n.sx; L.y = n.sy; L.off = n.sr * 1.2 + 8; L.depth = n.depth; });
  itens.forEach(o => { const dc = projeta(o.pos, o); o.sr = o.lua ? .3 / dc * ft : Math.max(3, o.tam * 95 / dc * .5); if (o.lua){ const L = o.rot; L.vis = o.vis && o.sr > 2.5; L.x = o.sx; L.y = o.sy; L.off = o.sr + 4; L.depth = o.depth; } });
  ORDEM.forEach(g => { const S = sistemas[g]; let cx = 0, cy = 0, minY = 1e9, vis = 0;
    for (const b of S.borda){ projeta(b, pb); if (pb.depth < 1){ vis++; cx += pb.sx; minY = Math.min(minY, pb.sy); } }
    const L = S.rot; L.vis = vis > S.borda.length * .6; if (L.vis){ L.x = cx / vis; L.y = minY - 8; L.depth = .5; } });
  colocaRotulos();
  // render: cena → brilho → desfoque → composição
  renderer.setRenderTarget(rtCena); renderer.render(scene, camera);
  matLimiar.uniforms.t.value = rtCena.texture; passe(matLimiar, rtA);
  for (let i = 0; i < 2; i++){ matBlur.uniforms.t.value = rtA.texture; matBlur.uniforms.uDir.value.set(1, 0); passe(matBlur, rtB); matBlur.uniforms.t.value = rtB.texture; matBlur.uniforms.uDir.value.set(0, 1); passe(matBlur, rtA); }
  matFinal.uniforms.t.value = rtCena.texture; matFinal.uniforms.tB.value = rtA.texture; passe(matFinal, null);
  if (primeiro){ primeiro = false; canvas.classList.add('pronto'); }
}
quadro();
}
</script>
