function gira(dx, dy){
  const ang = Math.hypot(dx, dy) * .0052; if (!ang) return;
  eixoTmp.set(dy, dx, 0).normalize().applyQuaternion(camera.quaternion);
  qTmp.setFromAxisAngle(eixoTmp, ang); mundo.quaternion.premultiply(qTmp);
}
