<style>
:root{
  --bg:#03050a; --ink:#eef3f8; --ink2:#a9b5c2; --ink3:#66727f;
  --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.16);
  --acc:#38e1c6; --gut:clamp(16px,3.6vw,44px); --ease:cubic-bezier(.2,.7,.1,1);
  --f-disp:"Space Grotesk",ui-sans-serif,system-ui,sans-serif;
  --f-body:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-serif:"Instrument Serif",ui-serif,Georgia,serif;
  --f-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Consolas,monospace;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;overflow:hidden;overscroll-behavior:none}
a{color:inherit}
a:hover{color:#fff}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--acc);outline-offset:3px;border-radius:8px}
.mono{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.18em;text-transform:uppercase}
.serif{font-family:var(--f-serif);font-style:italic;font-weight:400}

#universo{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab;opacity:0;transition:opacity 1.2s ease}
#universo.pronto{opacity:1}
#universo.arrastando{cursor:grabbing}
#universo.alvo{cursor:pointer}
.vinheta{position:fixed;inset:0;z-index:1;pointer-events:none;background:radial-gradient(120% 90% at 50% 48%,transparent 55%,rgba(0,0,0,.62))}

/* rótulos — sem caixas */
#rotulos{position:fixed;inset:0;z-index:4;pointer-events:none;transition:opacity .4s}
.rot{position:absolute;left:0;top:0;display:flex;flex-direction:column;align-items:center;gap:3px;padding:3px 6px;white-space:nowrap;pointer-events:auto;will-change:transform;opacity:0;transition:opacity .25s}
.rot b{display:flex;align-items:baseline;gap:6px;font-family:var(--f-disp);font-weight:500;font-size:clamp(.9rem,1.1vw,1.12rem);letter-spacing:-.01em;color:#fff;text-shadow:0 0 14px #000,0 0 3px #000;cursor:pointer;transition:color .25s}
.rot:hover b .nm,.rot.hover b .nm{color:var(--c)}
.rot b .ir{font-family:var(--f-disp);font-weight:500;font-size:.85em;color:var(--ink3);text-decoration:none;transition:color .2s,transform .2s var(--ease);display:inline-block}
.rot b .ir:hover{color:var(--c);transform:translate(1px,-1px)}
.rot small{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.17em;text-transform:uppercase;color:var(--c);text-shadow:0 0 10px #000,0 0 2px #000}
.rot small.tag{font-family:var(--f-serif);font-style:italic;font-size:.95rem;letter-spacing:0;text-transform:none}
.rot.lua b{font-size:clamp(.78rem,.92vw,.9rem);color:color-mix(in oklab,var(--c) 28%,white)}
.rot.lua small{font-size:.54rem}
.rot-sis{position:absolute;left:0;top:0;padding:6px 10px;border:0;background:none;font-family:var(--f-mono);font-size:.72rem;letter-spacing:.34em;text-transform:uppercase;color:var(--c);white-space:nowrap;text-shadow:0 0 16px #000;cursor:pointer;pointer-events:auto;will-change:transform;opacity:0;transition:opacity .25s,letter-spacing .3s}
.rot-sis:hover{letter-spacing:.42em}

/* tooltip de item */
#dica{position:fixed;z-index:80;left:0;top:0;pointer-events:none;padding:9px 12px;border-radius:12px;border:1px solid color-mix(in oklab,var(--c,#fff) 50%,transparent);background:rgba(6,10,16,.84);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);max-width:260px;opacity:0;transform:translate(14px,14px) scale(.96);transition:opacity .15s,transform .15s;white-space:normal}
#dica.on{opacity:1;transform:translate(14px,14px)}
#dica small{display:block;font-family:var(--f-mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--c,var(--acc))}
#dica b{display:block;font-family:var(--f-disp);font-weight:500;font-size:.92rem;line-height:1.2;margin-top:3px}

/* marca e dicas */
.marca{position:fixed;z-index:6;left:var(--gut);top:calc(var(--gut) - 4px);display:flex;flex-direction:column;gap:4px;pointer-events:none}
.marca b{font-family:var(--f-disp);font-weight:500;font-size:.95rem;letter-spacing:-.01em}
.marca span{color:var(--ink3);white-space:nowrap}
.dica-uso{position:fixed;z-index:6;left:50%;bottom:calc(var(--gut) - 2px);transform:translateX(-50%);display:flex;align-items:center;gap:10px;color:var(--ink3);pointer-events:none;transition:opacity .6s;white-space:nowrap}
.dica-uso i{width:24px;height:24px;border:1px solid var(--line2);border-radius:50%;position:relative;flex:none}
.dica-uso i::after{content:"";position:absolute;width:6px;height:6px;border-radius:50%;background:var(--acc);top:50%;left:50%;margin:-3px;animation:arrasta 2.6s var(--ease) infinite}
@keyframes arrasta{0%,100%{transform:translateX(-5px)}50%{transform:translateX(5px)}}
body.mexeu .dica-uso{opacity:0}

/* controles */
.controles{position:fixed;z-index:6;right:var(--gut);bottom:var(--gut);display:flex;flex-direction:column;gap:8px}
.controles button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line2);background:rgba(255,255,255,.04);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);cursor:pointer;display:grid;place-items:center;font-family:var(--f-disp);font-size:1.25rem;font-weight:500;line-height:1;transition:background .2s,border-color .2s}
.controles button:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.3)}
.controles svg{width:18px;height:18px}

/* painel de vidro */
.painel{position:fixed;z-index:70;right:var(--gut);top:var(--gut);width:min(400px,calc(100vw - 2*var(--gut)));max-height:calc(100vh - 2*var(--gut));overflow:auto;padding:26px;border-radius:26px;border:1px solid color-mix(in oklab,var(--c,#fff) 40%,transparent);background:linear-gradient(160deg,color-mix(in oklab,var(--c,#fff) 14%,transparent),rgba(6,10,16,.74) 50%);backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);box-shadow:0 40px 100px -40px var(--c,#000);transform:translateX(30px);opacity:0;visibility:hidden;transition:transform .5s var(--ease),opacity .5s,visibility .5s;scrollbar-width:thin;scrollbar-color:var(--line2) transparent}
.painel.aberto{transform:none;opacity:1;visibility:visible}
.painel .mono{color:var(--c);display:block}
.painel h3{margin:10px 0 6px;font-family:var(--f-disp);font-weight:500;font-size:2rem;line-height:1;letter-spacing:-.03em}
.painel .lema{font-family:var(--f-serif);font-style:italic;font-size:1.2rem;color:var(--c);margin:0 0 12px;line-height:1.25}
.painel p{margin:0 0 16px;color:var(--ink2);font-size:.9rem}
.painel .lst{list-style:none;margin:0 0 18px;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:3px;max-height:240px;overflow:auto;scrollbar-width:thin;scrollbar-color:var(--line2) transparent}
.painel .lst li{min-width:0}
.painel .lst a,.painel .lst button{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;min-width:0;padding:8px 10px;border-radius:10px;text-decoration:none;font-size:.82rem;border:1px solid transparent;background:none;text-align:left;cursor:pointer;color:var(--ink)}
.painel .lst a:hover,.painel .lst button:hover{border-color:var(--line2);background:rgba(255,255,255,.04)}
.painel .lst small{color:var(--ink3);font-size:.64rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:42%;flex:none;font-family:var(--f-mono);letter-spacing:.06em}
.painel .lst i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--pc);box-shadow:0 0 8px var(--pc);margin-right:10px;flex:none}
.painel .lst em{font-style:normal;font-family:var(--f-disp);color:var(--ink3);margin-left:8px}
.painel .lst .nome{display:flex;align-items:center;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.painel .bts{display:flex;gap:8px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line2);background:rgba(255,255,255,.04);text-decoration:none;font-weight:550;font-size:.88rem;cursor:pointer;white-space:nowrap;transition:background .25s,border-color .25s,box-shadow .25s}
.btn:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.3);color:#fff}
.btn.cheio{background:var(--c);color:#011;border-color:transparent;box-shadow:0 10px 40px -10px var(--c)}
.btn.cheio:hover{color:#011;box-shadow:0 16px 54px -8px var(--c)}
.painel .fechar{position:absolute;right:14px;top:14px;width:40px;height:40px;border-radius:50%;border:1px solid var(--line2);background:rgba(0,0,0,.3);cursor:pointer;display:grid;place-items:center}
.painel .fechar svg{width:16px;height:16px}

/* sem WebGL */
.ceu{position:fixed;inset:0;z-index:0;display:none;background:radial-gradient(40vw 40vh at 70% 35%,#38e1c622,transparent 70%),radial-gradient(40vw 40vh at 85% 70%,#ff5a2c1c,transparent 70%),radial-gradient(50vw 50vh at 20% 80%,#a58cff18,transparent 70%),var(--bg)}
#fallback{position:fixed;inset:0;z-index:5;display:none;overflow:auto;padding:calc(var(--gut) + 56px) var(--gut) var(--gut)}
#fallback .grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;max-width:1100px;margin:0 auto}
#fallback .sis{padding:22px;border-radius:22px;border:1px solid color-mix(in oklab,var(--c) 40%,transparent);background:rgba(6,10,16,.6)}
#fallback .sis .mono{color:var(--c);display:block;margin-bottom:12px}
#fallback .sis a{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--line);text-decoration:none;font-family:var(--f-disp);font-weight:500}
#fallback .sis a small{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--pc);align-self:center}
#fallback h1{font-family:var(--f-disp);font-weight:500;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.03em;margin:0 0 24px;text-align:center}
#fallback h1 .serif{color:var(--acc)}
html.sem-webgl .ceu,html.sem-webgl #fallback{display:block}
html.sem-webgl #universo,html.sem-webgl #rotulos,html.sem-webgl .controles,html.sem-webgl .dica-uso,html.sem-webgl #dica{display:none}

@media (max-width:640px){
  .rot b{font-size:.8rem}.rot small{font-size:.52rem}.rot small.tag{font-size:.8rem}
  .rot-sis{font-size:.6rem;letter-spacing:.26em}
  .marca b{font-size:.85rem}.marca span{font-size:.58rem}
  .dica-uso{bottom:auto;top:calc(var(--gut) + 48px);left:var(--gut);transform:none;font-size:.56rem}
  .controles{bottom:calc(var(--gut) + env(safe-area-inset-bottom))}
  .painel{top:auto;right:12px;left:12px;bottom:12px;width:auto;max-height:62vh;border-radius:22px;padding:22px;transform:translateY(30px)}
  .painel.aberto{transform:none}
  .painel h3{font-size:1.6rem}.painel .lst{max-height:160px}
}
@media (prefers-reduced-motion:reduce){
  .dica-uso i::after{animation:none}
}
</style>
</head>
<body>
<canvas id="universo" aria-label="Universo interativo: três sistemas de experiências educacionais" role="img"></canvas>
<div class="ceu" aria-hidden="true"></div>
<div class="vinheta" aria-hidden="true"></div>
<div id="rotulos" aria-hidden="true"></div>
<div id="dica" aria-hidden="true"></div>

<header class="marca">
  <b>Prof. Mário César Nascimento, PhD</b>
  <span class="mono">Fisiologia · Ética · Pesquisa · Jogos</span>
</header>

<div class="dica-uso mono" aria-hidden="true"><i></i><span>Arraste para girar · role para aproximar · clique num planeta</span></div>

<div class="controles" aria-label="Zoom">
  <button type="button" id="zoomMais" aria-label="Aproximar">+</button>
  <button type="button" id="zoomMenos" aria-label="Afastar">−</button>
  <button type="button" id="recentrar" aria-label="Recentralizar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg></button>
</div>

<aside class="painel" id="painel" aria-label="Detalhes" aria-hidden="true">
  <button class="fechar" type="button" id="fechaPainel" aria-label="Fechar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <div id="painelCorpo"></div>
</aside>

<section id="fallback" aria-label="Mundos"><h1>Ciência que você pode <span class="serif">tocar.</span></h1><div class="grade" id="fallbackGrade"></div></section>

<script src="universo-dados.js"></script>
<script type="module">
const U = window.U;
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const MOBILE = matchMedia('(max-width:640px)').matches;
const TOQUE = matchMedia('(pointer:coarse)').matches;
const REDUZ = matchMedia('(prefers-reduced-motion: reduce)').matches;
const ORDEM = ['aula','dragon','lab'];
const centralDe = g => U.repos.find(r => r.grupo === g && !r.grupos && !('pai' in r));
const linha2 = r => r.tag ? r.tag : `${r.total} ${r.total === 1 ? 'ITEM' : 'ITENS'}${'pai' in r ? ' · APOIO' : ''}`;
const nomeLua = s => s.replace(/^MOSAICO - /, '').replace(/^A Casa da Costa: /, '');

/* ---------- alternativa sem WebGL ---------- */
function montaFallback(){
  document.documentElement.classList.add('sem-webgl');
  $('#fallbackGrade').innerHTML = ORDEM.map(g => {
    const c = centralDe(g);
    const mundos = U.repos.filter(r => r.grupo === g || (r.grupos && r.grupos.includes(g)));
    return `<div class="sis" style="--c:${c.cor}"><span class="mono">${esc(U.grupos[g].pt)}</span>${mundos.map(r =>
      `<a href="${r.online}" target="_blank" rel="noopener" style="--pc:${r.cor}">${esc(r.nome)}<small>${esc(linha2(r))}</small></a>`).join('')}</div>`;
  }).join('');
}

let THREE;
try {
  const c = document.createElement('canvas');
  if (!(c.getContext('webgl2') || c.getContext('webgl'))) throw new Error('WebGL indisponível');
  THREE = await import('three');
} catch (e) { console.warn('[universo]', e); montaFallback(); }
if (THREE) iniciar();

function iniciar(){
const canvas = $('#universo');
let renderer;
try { renderer = new THREE.WebGLRenderer({ canvas, antialias:false, alpha:false, powerPreference:'high-performance' }); }
catch (e) { console.warn('[universo]', e); return montaFallback(); }
const PR = Math.min(devicePixelRatio || 1, TOQUE ? 1.5 : 2);
renderer.setPixelRatio(PR);
renderer.setClearColor(0x03050a, 1);
const V3 = (x,y,z) => new THREE.Vector3(x,y,z);
const tmp = V3(), tmp2 = V3();

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(MOBILE ? 60 : 46, 1, 0.1, 900);
let W = 1, H = 1;

/* ---------- pós-processamento: bloom suave (sem addons) ---------- */
const meioFloat = renderer.capabilities.isWebGL2 && (renderer.extensions.has('EXT_color_buffer_half_float') || renderer.extensions.has('EXT_color_buffer_float'));
const tipoRT = meioFloat ? THREE.HalfFloatType : THREE.UnsignedByteType;
const rtCena = new THREE.WebGLRenderTarget(1, 1, { type: tipoRT, depthBuffer: true });
const rtA = new THREE.WebGLRenderTarget(1, 1, { type: tipoRT, depthBuffer: false });
const rtB = new THREE.WebGLRenderTarget(1, 1, { type: tipoRT, depthBuffer: false });
const quadVS = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy, 0., 1.); }`;
const matLimiar = new THREE.ShaderMaterial({ depthTest:false, depthWrite:false, uniforms:{ t:{value:null}, uLim:{value:.62} }, vertexShader:quadVS,
  fragmentShader:`uniform sampler2D t; uniform float uLim; varying vec2 vUv;
  void main(){ vec3 c = texture2D(t, vUv).rgb; float l = max(max(c.r, c.g), c.b); float k = smoothstep(uLim, uLim + .45, l); gl_FragColor = vec4(c * k, 1.); }` });
const matBlur = new THREE.ShaderMaterial({ depthTest:false, depthWrite:false, uniforms:{ t:{value:null}, uDir:{value:new THREE.Vector2(1,0)}, uRes:{value:new THREE.Vector2(1,1)} }, vertexShader:quadVS,
  fragmentShader:`uniform sampler2D t; uniform vec2 uDir, uRes; varying vec2 vUv;
  void main(){ vec2 px = uDir / uRes; vec3 c = texture2D(t, vUv).rgb * .227;
    c += (texture2D(t, vUv + px * 1.385).rgb + texture2D(t, vUv - px * 1.385).rgb) * .316;
    c += (texture2D(t, vUv + px * 3.231).rgb + texture2D(t, vUv - px * 3.231).rgb) * .07;
    gl_FragColor = vec4(c, 1.); }` });
const matFinal = new THREE.ShaderMaterial({ depthTest:false, depthWrite:false, uniforms:{ t:{value:null}, tB:{value:null}, uForca:{value: MOBILE ? .8 : .95} }, vertexShader:quadVS,
  fragmentShader:`uniform sampler2D t, tB; uniform float uForca; varying vec2 vUv;
  void main(){ vec3 c = texture2D(t, vUv).rgb + texture2D(tB, vUv).rgb * uForca; c = 1. - exp(-c * 1.25); gl_FragColor = vec4(pow(c, vec3(1. / 2.2)), 1.); }` });
const quadCena = new THREE.Scene(), quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), matFinal); quad.frustumCulled = false; quadCena.add(quad);
function passe(mat, alvo){ quad.material = mat; renderer.setRenderTarget(alvo); renderer.render(quadCena, quadCam); }

/* ---------- GLSL: simplex 3D (Ashima Arts / Stefan Gustavson, MIT) ---------- */
const NOISE = `
vec3 mod289(vec3 x){return x-floor(x*(1./289.))*289.;} vec4 mod289(vec4 x){return x-floor(x*(1./289.))*289.;}
vec4 permute(vec4 x){return mod289(((x*34.)+1.)*x);} vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-.85373472095314*r;}
float snoise(vec3 v){ const vec2 C=vec2(1./6.,1./3.); const vec4 D=vec4(0.,.5,1.,2.);
  vec3 i=floor(v+dot(v,C.yyy)); vec3 x0=v-i+dot(i,C.xxx); vec3 g=step(x0.yzx,x0.xyz); vec3 l=1.-g; vec3 i1=min(g.xyz,l.zxy); vec3 i2=max(g.xyz,l.zxy);
  vec3 x1=x0-i1+C.xxx; vec3 x2=x0-i2+C.yyy; vec3 x3=x0-D.yyy; i=mod289(i);
  vec4 p=permute(permute(permute(i.z+vec4(0.,i1.z,i2.z,1.))+i.y+vec4(0.,i1.y,i2.y,1.))+i.x+vec4(0.,i1.x,i2.x,1.));
  float n_=.142857142857; vec3 ns=n_*D.wyz-D.xzx; vec4 j=p-49.*floor(p*ns.z*ns.z); vec4 x_=floor(j*ns.z); vec4 y_=floor(j-7.*x_);
  vec4 x=x_*ns.x+ns.yyyy; vec4 y=y_*ns.x+ns.yyyy; vec4 h=1.-abs(x)-abs(y); vec4 b0=vec4(x.xy,y.xy); vec4 b1=vec4(x.zw,y.zw);
