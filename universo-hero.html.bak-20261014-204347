  canvas.setPointerCapture(e.pointerId); ptrs.set(e.pointerId, { x:e.clientX, y:e.clientY });
  inercia.dx = inercia.dy = 0; interagiu(); arrastou = false;
  if (ptrs.size === 1) down = { x:e.clientX, y:e.clientY, t:performance.now(), id:e.pointerId };
  if (ptrs.size === 2){ const [a, b] = [...ptrs.values()]; pinca0 = Math.hypot(a.x - b.x, a.y - b.y); distPinca0 = distAlvo; down = null; }
