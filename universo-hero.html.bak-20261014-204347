  if (ptrs.has(e.pointerId)){
    const p = ptrs.get(e.pointerId); const dx = e.clientX - p.x, dy = e.clientY - p.y; p.x = e.clientX; p.y = e.clientY; interagiu();
    if (ptrs.size === 1){ gira(dx, dy); inercia.dx = inercia.dx * .5 + dx * .5; inercia.dy = inercia.dy * .5 + dy * .5; if (Math.hypot(dx, dy) > 1) arrastou = true; }
    else if (ptrs.size === 2){ const [a, b] = [...ptrs.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y); if (d > 0 && pinca0 > 0) distAlvo = limitaDist(distPinca0 * pinca0 / d); }
